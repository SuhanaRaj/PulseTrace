PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/pulsetrace
JWT_SECRET=change_me

# HTTP tracing (optional)
SERVICE_NAME=pulsetrace-backend
# Comma-separated path prefixes that are NOT traced
# Default (when unset): PulseTrace's own API incl. /api/telemetry, see src/config/traceIgnore.js
# TRACE_IGNORE_PATHS=/api/health,/api/traces,/api/spans,/api/errors,/api/performance,/api/service-map,/api/services,/api/settings,/api/projects,/api/telemetry

# Browser origins allowed by CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Projects: the project this server's own telemetry (automatic HTTP tracing) belongs to.
# Valid ids are defined in src/config/projects.js (pulsetrace, api-suite). Default: pulsetrace
PROJECT_ID=pulsetrace
# true = REST requests must carry an explicit projectId (no fallback to PROJECT_ID)
REQUIRE_PROJECT_ID=false
